{
  "name": "siryou-mite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "typecheck:services": "tsc -p tsconfig.services.json --noEmit",
    "build:services": "tsc -p tsconfig.services.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run typecheck:services && npm run test:coverage && npm run build && npm run build:services"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/storage-blob": "12.33.0",
    "@azure/storage-queue": "12.31.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "isbot": "5.1.35",
    "node-pg-migrate": "9.0.0",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@react-router/dev": "8.3.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
