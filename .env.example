NODE_ENV=development
PORT=3000
APP_NAME=社内Webアプリ
APP_ORIGIN=http://localhost:3000

# ローカル開発では dev、本番では必ず easyauth
AUTH_MODE=dev
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800

# AUTH_MODE=easyauth のとき必須。App Service Easy Authと同じtenantを指定
ENTRA_TENANT_ID=

# PostgreSQL接続文字列。本番はManaged IdentityのEntra ID access tokenを
# passwordとして接続する(設計 §7.4)。値そのものはKey Vault参照で渡す。
# devcontainerの`dev`serviceでは`.devcontainer/docker-compose.yml`が
# `postgres:5432`ホスト名で上書きするため、以下はdevcontainer外(ホスト直接接続、
# ポートは127.0.0.1へforwardされる)向けの値
DATABASE_URL=postgres://user:password@localhost:5432/siryou_mite

# HTML表示サービス(Display)のオリジン。hidden formのPOST先として使う(設計 §7.2)。
# scheme+host+portのみを許可し、パス・クエリは指定できない(末尾スラッシュは正規化される)
DISPLAY_ORIGIN=http://localhost:3100

# Blob/Queueへの接続設定(設計 §7.3)。
# ローカル・開発はAzurite接続文字列、本番はAZURE_STORAGE_ACCOUNT_NAMEと
# Managed Identityを使う(本番でAZURE_STORAGE_CONNECTION_STRINGは使用禁止)。
# 2つは同時に指定できない(両方空欄・両方指定はどちらも拒否される)。
# `UseDevelopmentStorage=true`はAzuriteが127.0.0.1で動く場合の省略記法であり、
# devcontainerの`dev`serviceからは使えない(Azuriteは別コンテナ`azurite`で動く)。
# devcontainerでは`.devcontainer/docker-compose.yml`がBlobEndpoint/QueueEndpointを
# `azurite:10000`/`azurite:10001`に指定した接続文字列で上書きする
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# 本番用。Managed Identityでaccount URLを組み立てるstorageアカウント名
# AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=documents
AZURE_STORAGE_QUEUE_NAME=preview-generation

# 表示grant署名鍵(設計 §7.2, §9.5)。Ed25519のPEM秘密鍵と`keyId`。
# `openssl genpkey -algorithm ed25519` で生成し、Displayには対応する公開鍵だけを渡す。
# rotationはkeyIdを変えて新しい鍵を設定し、旧grantが失効(60秒)してから旧鍵を無効化する。
# 下記の`\n`表記はローカルで`.env`ファイルへ実改行を書く場合の例示であり、
# `docker run --env-file`など`\n`を展開しない実行方法では使えない。本番はKey Vault
# 参照で実改行を含むPEM値をそのまま環境変数へ渡す
GRANT_SIGNING_KEY_ID=replace-with-key-id
GRANT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GRANT_TTL_SECONDS=60

# ログへ記録するID等をpseudonymize化するHMAC鍵。base64で32byte以上(設計 §9.5)。
# 生成例: openssl rand -base64 32
LOG_HMAC_KEY=replace-with-base64-encoded-32-bytes-or-more

# アップロード制限値(設計 §6.1)。既定値は設計の規定値と一致する
MAX_HTML_UPLOAD_BYTES=10485760
MAX_ACTIVE_DOCUMENTS_PER_USER=100
MAX_TOTAL_HTML_BYTES_PER_USER=524288000
MAX_TOTAL_HTML_BYTES_SYSTEM=53687091200
SYSTEM_HTML_BYTES_WARNING_THRESHOLD=42949672960
UPLOAD_RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_UPLOADS_PER_USER=1
